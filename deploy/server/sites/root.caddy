# evil-teacher.ru — a placeholder page, over HTTPS from Caddy (Let's Encrypt).

(placeholder) {
	root * /srv/root
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "public, max-age=600"
	}

	# a single page: every other path gets it too, with a 404
	handle_errors {
		rewrite * /index.html
		file_server
	}
}

evil-teacher.ru {
	import placeholder
}

# www is only an alias
www.evil-teacher.ru {
	redir https://evil-teacher.ru{uri} permanent
}

# Plain-HTTP catch-all: the bare IP, or a name nobody configured, gets the placeholder rather
# than a real site. Named sites above still get Caddy's HTTP-to-HTTPS redirect — more specific
# hosts win over this block.
:80 {
	import placeholder
}
