# evil-teacher.ru — a placeholder page. Also the catch-all: any Host no other file claims
# (the bare IP, a subdomain someone forgot to configure) lands here rather than on a real site.
http://evil-teacher.ru, :80 {
	root * /srv/root
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "public, max-age=600"
	}

	# a single page: every other path gets it too, with a 404
	handle_errors {
		rewrite * /index.html
		file_server
	}
}

# www is only an alias. Redirecting to another host over https is safe behind the proxy;
# what loops is a redirect from http:// to https:// on the same name.
http://www.evil-teacher.ru {
	redir https://evil-teacher.ru{uri} permanent
}
