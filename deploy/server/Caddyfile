# /etc/caddy/Caddyfile — shared by every site on this box.
#
# Each site owns one file under /etc/caddy/sites/ and its deploy writes only that file:
#   labs.caddy       labs repo, deploy/server/sites/
#   root.caddy       labs repo, deploy/server/sites/ (placeholder on the bare domain)
#   anti-fly.caddy   anti_fly repo, deploy/push.sh
#
# DNS lives in Cloudflare but no record is proxied: Russian ISPs throttle Cloudflare to the first
# ~16 KB of a response, which breaks every page with a stylesheet. So visitors reach this box
# directly and Caddy owns TLS — Let's Encrypt certificates and the HTTP-to-HTTPS redirects.
# Never turn the orange cloud back on for these names: with Caddy redirecting to HTTPS behind
# a Flexible proxy, every request would loop.

import /etc/caddy/sites/*.caddy
